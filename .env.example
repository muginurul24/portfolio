# ─── Site ───────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SUPPORT_EMAIL=support@mugiewdev.com
NUXT_PUBLIC_WHATSAPP_NUMBER=6281280080275

# ─── Session (min 32 chars) ─────────────────────────────
# Required for nuxt-auth-utils sealed cookies.
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32chars-min
# Dev logins after seed: mugiew@nuxt.dev / aa123123 ; demo@mugiewdev.com / Demo1234!

# ─── Pay-access token (HMAC, min 32 chars) ──────────────
# Optional dedicated secret for /order/pay tokens. Falls back to NUXT_SESSION_PASSWORD.
# Paid order create FAILS 500 if effective secret length < 32 (no orphan pending_payment).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_PAY_TOKEN_SECRET=

# ─── OG Image (nuxt-og-image) ───────────────────────────
# Stable secret so signed OG URLs survive rebuilds / multi-instance.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_OG_IMAGE_SECRET=

# ─── Database ───────────────────────────────────────────
NUXT_DATABASE_URL=file:./.data/mugiew.sqlite
# NUXT_DATABASE_URL=postgresql://user:pass@localhost:5432/mugiewdev

# ─── Payments (QrisVIP / Otomatis VIP — QRIS only) ──────
# QRIS amount bounds: min Rp 10.000 / max Rp 10.000.000 (server-enforced).
NUXT_QRISVIP_UUID=
NUXT_QRISVIP_CLIENT=
NUXT_QRISVIP_CLIENT_KEY=
NUXT_QRISVIP_USERNAME=
NUXT_QRISVIP_EXPIRE_SECONDS=1200
# Shared secret for POST /api/webhooks/qrisvip (header x-qrisvip-secret / x-callback-token / Bearer).
# REQUIRED in production (NODE_ENV=production) — empty secret → 500 fail-closed.
# Also required when NUXT_QRISVIP_REQUIRE_WEBHOOK_SECRET=true (e.g. staging).
NUXT_QRISVIP_WEBHOOK_SECRET=
# NUXT_QRISVIP_REQUIRE_WEBHOOK_SECRET=true
# NUXT_QRISVIP_BASE_URL=https://qris.otomatis.vip

# ─── Email (Resend) ─────────────────────────────────────
NUXT_RESEND_API_KEY=

# ─── Cron (order expiry etc.) ───────────────────────────
# Shared secret for POST /api/cron/expire-orders (header x-cron-secret or ?secret=).
# Empty secret → 401 fail-closed.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_CRON_SECRET=

# ─── Optional ───────────────────────────────────────────
# NUXT_WHATSAPP_NUMBER=6281280080275
