# ─── Site ───────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SUPPORT_EMAIL=support@mugiewdev.com
NUXT_PUBLIC_WHATSAPP_NUMBER=6281280080275

# ─── Session (min 32 chars) ─────────────────────────────
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32chars-min
# Dev logins after seed: mugiew@nuxt.dev / aa123123 ; demo@mugiewdev.com / Demo1234!

# ─── OG Image (nuxt-og-image) ───────────────────────────
# Stable secret so signed OG URLs survive rebuilds / multi-instance.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_OG_IMAGE_SECRET=

# ─── Database ───────────────────────────────────────────
NUXT_DATABASE_URL=file:./.data/mugiew.sqlite
# NUXT_DATABASE_URL=postgresql://user:pass@localhost:5432/mugiewdev

# ─── Payments (QrisVIP / Otomatis VIP — QRIS only) ──────
NUXT_QRISVIP_UUID=
NUXT_QRISVIP_CLIENT=
NUXT_QRISVIP_CLIENT_KEY=
NUXT_QRISVIP_USERNAME=
NUXT_QRISVIP_EXPIRE_SECONDS=1200
NUXT_QRISVIP_WEBHOOK_SECRET=
# NUXT_QRISVIP_BASE_URL=https://qris.otomatis.vip

# ─── Email (Resend) ─────────────────────────────────────
NUXT_RESEND_API_KEY=

# ─── Optional ───────────────────────────────────────────
# NUXT_WHATSAPP_NUMBER=6281280080275
